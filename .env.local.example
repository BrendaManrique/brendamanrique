# =============================================================================
#  ⚠  TEMPLATE ONLY — THIS FILE IS COMMITTED TO GITHUB  ⚠
#  NEVER put real keys here. Copy it to .env.local and fill that one instead.
# =============================================================================
# Real values live in .env.local (gitignored), never here.
# Leave any OPTIONAL var blank to skip that feature — the code degrades
# gracefully rather than crashing.
#
# Two secrets are generated, not fetched — run this to make them:
#   openssl rand -hex 32
# =============================================================================


# ---- REQUIRED: the chat will not respond without this ----------------------
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=


# ---- REQUIRED for RAG retrieval + voice mode -------------------------------
# Without these the chat still answers, but with no portfolio evidence
# retrieved and voice mode disabled.

# platform.openai.com → API Keys  (embeddings + realtime voice)
OPENAI_API_KEY=

# Supabase Dashboard → Project Settings → API
# Needs pgvector + the schema in scripts/supabase-setup.sql applied first.
# Use the SERVICE ROLE key, not the anon key — it is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ---- OPTIONAL: observability (Langfuse) ------------------------------------
# Traces, prompt registry, eval scores. Chat works fine without it; the ops
# dashboard will be empty. Build-time prompt sync skips itself if unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com


# ---- OPTIONAL: ops dashboard + daily eval cron -----------------------------
# Bearer tokens you invent. Generate each with: openssl rand -hex 32
# OPS_DASHBOARD_SECRET gates /api/ops/* (the LLMOps dashboard login).
# CRON_SECRET gates /api/cron/evaluate, which vercel.json runs daily at 08:00.
OPS_DASHBOARD_SECRET=
CRON_SECRET=

# Lets a caller pin a specific prompt version when testing. Generate one too,
# or leave blank if you will not run prompt regressions against production.
PROMPT_REGRESSION_SECRET=


# ---- OPTIONAL: failure alerts ----------------------------------------------
# resend.com → API Keys. Emails you when RAG retrieval starts failing.
RESEND_API_KEY=
ALERT_EMAIL=


# ---- OPTIONAL: flags -------------------------------------------------------
# Scores every conversation with an LLM judge at ~$0.001 each. Off by default.
ENABLE_ONLINE_SCORING=false

# Only used by local scripts (prompt-regression, adversarial-test), never by
# the deployed app. Defaults to localhost:3000 when blank.
CHAT_API_URL=

