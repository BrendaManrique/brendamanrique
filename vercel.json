{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/funding-manifest-urls",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; media-src 'self' data:; script-src 'self' 'unsafe-inline' https://vercel.live; style-src 'self' 'unsafe-inline' https://vercel.live; font-src 'self' https://vercel.live; img-src 'self' data: https:; connect-src 'self' https://vercel.live https://*.pusher.com wss://*.pusher.com https://va.vercel-scripts.com https://vitals.vercel-insights.com wss://api.openai.com https://api.openai.com; frame-src 'self' https://vercel.live https://player.mux.com https://www.youtube.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "X-Open-To",
          "value": "interesting-problems"
        },
        {
          "key": "X-Built-With",
          "value": "Claude Code"
        },
        {
          "key": "X-Resume",
          "value": "/llms.txt"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en/",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/moodys",
      "destination": "/moodys/index.html"
    },
    {
      "source": "/moodys-credit-intelligence",
      "destination": "/moodys-credit-intelligence/index.html"
    },
    {
      "source": "/sistemas-financieros",
      "destination": "/sistemas-financieros/index.html"
    },
    {
      "source": "/financial-systems",
      "destination": "/financial-systems/index.html"
    },
    {
      "source": "/consultoria-ia-agentica",
      "destination": "/consultoria-ia-agentica/index.html"
    },
    {
      "source": "/agentic-ai-consulting",
      "destination": "/agentic-ai-consulting/index.html"
    },
    {
      "source": "/agente-de-portafolio",
      "destination": "/agente-de-portafolio/index.html"
    },
    {
      "source": "/portfolio-chat-agent",
      "destination": "/portfolio-chat-agent/index.html"
    },
    {
      "source": "/casicornio",
      "destination": "/casicornio/index.html"
    },
    {
      "source": "/en/casicornio",
      "destination": "/en/casicornio/index.html"
    },
    {
      "source": "/invip",
      "destination": "/invip/index.html"
    },
    {
      "source": "/invip-accessibility-ai",
      "destination": "/invip-accessibility-ai/index.html"
    },
    {
      "source": "/dimension-fractal",
      "destination": "/dimension-fractal/index.html"
    },
    {
      "source": "/fractal-dimension",
      "destination": "/fractal-dimension/index.html"
    },
    {
      "source": "/proyectos-iniciales",
      "destination": "/proyectos-iniciales/index.html"
    },
    {
      "source": "/early-projects",
      "destination": "/early-projects/index.html"
    },
    {
      "source": "/historia",
      "destination": "/historia/index.html"
    },
    {
      "source": "/story",
      "destination": "/story/index.html"
    },
    {
      "source": "/sobre-mi",
      "destination": "/sobre-mi/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/evaluate",
      "schedule": "0 8 * * *"
    }
  ]
}
